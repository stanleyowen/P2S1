# Copy to server/.env (gitignored) on the Ubuntu host.

# Cloudflare Zero Trust → Networks → Tunnels → Create tunnel → copy the token.
CLOUDFLARE_TUNNEL_TOKEN=

# Comma-separated list of sites allowed to call the API from a browser.
ALLOWED_ORIGINS=https://p2s1.netlify.app

# Per-IP token bucket.
RATE_LIMIT_PER_MIN=60
RATE_LIMIT_BURST=20
